---
import Layout from '../layouts/Layout.astro';
import { AnalysisDashboard } from '../components/pytorch/AnalysisDashboard';
export const prerender = false;
---

<Layout title="Hyperparameter Analysis">
  <div class="py-10">
    <header>
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="sm:flex sm:items-center sm:justify-between">
          <div>
            <div class="flex items-center gap-3 mb-1">
              <a href="/analytics" class="text-sm text-gray-500 hover:text-gray-700">Analytics</a>
              <span class="text-gray-300">/</span>
              <span class="text-sm text-gray-800 font-medium">Hyperparameter Analysis</span>
            </div>
            <h1 class="text-3xl font-bold leading-tight tracking-tight text-gray-900">
              Analysis
            </h1>
            <p class="mt-2 text-sm text-gray-600">
              Correlation plots · Parallel coordinates · Distributions · Aggregate curves
            </p>
          </div>
          <div class="mt-4 sm:mt-0 flex gap-3">
            <a
              href="/experiments"
              class="inline-flex items-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-700 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50"
            >
              Experiments
            </a>
            <a
              href="/analytics"
              class="inline-flex items-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-700 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50"
            >
              Analytics
            </a>
            <a
              href="/"
              class="inline-flex items-center rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500"
            >
              + New Run
            </a>
          </div>
        </div>
      </div>
    </header>

    <main>
      <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
        <AnalysisDashboard client:load />
      </div>
    </main>
  </div>
</Layout>
