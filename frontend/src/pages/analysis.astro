---
import Layout from '../layouts/Layout.astro';
import { Leaderboard } from '../components/pytorch/Leaderboard';
import { RunComparison } from '../components/pytorch/RunComparison';
import { HyperparameterDisplay } from '../components/pytorch/HyperparameterDisplay';

export const prerender = false;

// Active tab from query string (defaults to 'leaderboard')
const tab = Astro.url.searchParams.get('tab') ?? 'leaderboard';
const tabs = [
  { id: 'leaderboard',  label: 'Leaderboard',         icon: '🏆' },
  { id: 'compare',      label: 'Run Comparison',       icon: '📊' },
  { id: 'hyperparams',  label: 'Hyperparameters',      icon: '⚙️'  },
];
---

<Layout title="Analysis">
  <div class="py-10">
    <header>
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="sm:flex sm:items-center sm:justify-between">
          <div>
            <h1 class="text-3xl font-bold leading-tight tracking-tight text-gray-900">
              Analysis
            </h1>
            <p class="mt-2 text-sm text-gray-600">
              Leaderboard, run comparison, and hyperparameter analysis
            </p>
          </div>
          <div class="mt-4 sm:mt-0 flex gap-3">
            <a
              href="/scripts/new"
              class="inline-flex items-center rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500"
            >
              + New Run
            </a>
          </div>
        </div>
      </div>
    </header>

    <main>
      <div class="mx-auto max-w-7xl px-4 py-6 sm:px-6 lg:px-8">

        <!-- Tab nav -->
        <div class="border-b border-gray-200 mb-6">
          <nav class="-mb-px flex gap-6" id="tab-nav">
            {tabs.map(t => (
              <button
                data-tab={t.id}
                class={[
                  'flex items-center gap-1.5 pb-3 text-sm font-medium border-b-2 transition-colors tab-btn',
                  tab === t.id
                    ? 'border-indigo-600 text-indigo-600'
                    : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300',
                ].join(' ')}
              >
                <span>{t.icon}</span>
                {t.label}
              </button>
            ))}
          </nav>
        </div>

        <!-- Tab panels -->
        <div id="tab-leaderboard" class:list={['tab-panel', tab !== 'leaderboard' ? 'hidden' : '']}>
          <Leaderboard client:only="react" />
        </div>

        <div id="tab-compare" class:list={['tab-panel', tab !== 'compare' ? 'hidden' : '']}>
          <RunComparison client:only="react" />
        </div>

        <div id="tab-hyperparams" class:list={['tab-panel', tab !== 'hyperparams' ? 'hidden' : '']}>
          <HyperparameterDisplay client:only="react" />
        </div>

      </div>
    </main>
  </div>
</Layout>

<script>
  // Client-side tab switching without page reload
  const buttons = document.querySelectorAll<HTMLButtonElement>('.tab-btn');
  const panels  = document.querySelectorAll<HTMLElement>('.tab-panel');

  buttons.forEach(btn => {
    btn.addEventListener('click', () => {
      const target = btn.dataset.tab!;

      // Update URL without reload
      const url = new URL(window.location.href);
      url.searchParams.set('tab', target);
      window.history.replaceState({}, '', url.toString());

      // Show/hide panels
      panels.forEach(p => p.classList.toggle('hidden', !p.id.endsWith(target)));

      // Update button styles
      buttons.forEach(b => {
        const active = b.dataset.tab === target;
        b.classList.toggle('border-indigo-600', active);
        b.classList.toggle('text-indigo-600',   active);
        b.classList.toggle('border-transparent', !active);
        b.classList.toggle('text-gray-500',      !active);
      });
    });
  });
</script>
